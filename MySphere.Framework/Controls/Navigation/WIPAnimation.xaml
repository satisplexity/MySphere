<UserControl
    x:Class="MySphere.Framework.Controls.Navigation.WIPAnimation"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:MySphere.Framework.VisualHelpers"
    Margin="100"
    Loaded="UserControl_Loaded">

    <Border
        CornerRadius="200"
        helpers:ClipHelper.Enable="True">

        <Grid>
            
            <Grid.Background>

            <RadialGradientBrush
                GradientOrigin="-1,-1">

                <GradientStop
                    Color="#222232"
                    Offset="0"/>

                <GradientStop
                    Color="#111121"
                    Offset="1"/>

            </RadialGradientBrush>

        </Grid.Background>

            <Grid
                x:Name="PART_Container"
                RenderTransformOrigin="0.5, 0.5">

                <Grid.RenderTransform>

                    <RotateTransform
                        Angle="-10"/>

                </Grid.RenderTransform>

                <Ellipse
                    x:Name="PART_CenterEllipse"
                    Width="300"
                    Height="300"
                    Panel.ZIndex="10">

                    <Ellipse.Fill>

                        <RadialGradientBrush
                            GradientOrigin="-1,-1">

                            <GradientStop
                                Color="#A8F"
                                Offset="0"/>

                            <GradientStop
                                Color="#75D"
                                Offset="0.97"/>

                            <GradientStop
                                Color="#53A"
                                Offset="1"/>

                        </RadialGradientBrush>

                    </Ellipse.Fill>

                </Ellipse>

            </Grid>
            
        </Grid>
        
    </Border>

</UserControl>