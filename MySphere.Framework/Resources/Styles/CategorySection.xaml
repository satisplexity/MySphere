<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:MySphere.Framework.Controls.Layout"
    xmlns:helpers="clr-namespace:MySphere.Framework.VisualHelpers">

    <Style
        TargetType="{x:Type controls:CategorySection}">

        <Setter
            Property="Margin"
            Value="0, 30"/>

        <Setter
            Property="Template">

            <Setter.Value>

                <ControlTemplate
                    TargetType="{x:Type controls:CategorySection}">

                    <Border
                        Background="#1E1E1E"
                        CornerRadius="40"
                        BorderThickness="2"
                        helpers:ClipHelper.Enable="True">

                        <Border.BorderBrush>

                            <LinearGradientBrush
                                StartPoint="0.4, 0"
                                EndPoint="0.6, 1">

                                <GradientStop
                                    Color="#232324"
                                    Offset="0"/>

                                <GradientStop
                                    Color="#1B1B1B"
                                    Offset="1"/>

                            </LinearGradientBrush>

                        </Border.BorderBrush>

                        <Grid>

                            <Grid HorizontalAlignment="Right">


                                <Grid Width="300"
                                  Height="300"
                                  HorizontalAlignment="Right"
                                  RenderTransformOrigin="0.5, 0.5"
                                  Margin="0, 0, 100, 0">
                                    <Grid.RenderTransform>
                                        <TransformGroup>

                                            <RotateTransform Angle="-25"/>
                                            <ScaleTransform ScaleX="1.5"
                                                        ScaleY="1.5"/>
                                        </TransformGroup>
                                    </Grid.RenderTransform>

                                    <Path
                                Data="{TemplateBinding Icon}"
                                Fill="{TemplateBinding Foreground}"
                                Stretch="Uniform"
                                HorizontalAlignment="Right">

                                        <Path.Effect>

                                            <BlurEffect Radius="0"/>

                                        </Path.Effect>

                                    </Path>

                                    <Path
                                Data="{TemplateBinding Icon}"
                                Fill="{TemplateBinding Foreground}"
                                Stretch="Uniform"
                                HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>





                            <Grid Margin="20">

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="Auto"/>

                                    <RowDefinition/>

                                </Grid.RowDefinitions>

                                <TextBlock
                                    Text="{TemplateBinding Title}"
                                    FontSize="30"
                                    FontWeight="Bold"
                                    Foreground="#EEE"/>

                                <ContentPresenter
                                    Content="{TemplateBinding Content}"
                                    Grid.Row="1"/>

                            </Grid>

                        </Grid>

                    </Border>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

</ResourceDictionary>