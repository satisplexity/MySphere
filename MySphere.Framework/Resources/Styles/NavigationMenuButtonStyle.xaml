<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:xaml="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:MySphere.Framework.Controls.Navigation">

    <BackEase xaml:Key="ScaleEase"
              Amplitude="1.5"
              EasingMode="EaseOut"/>

    <CubicEase xaml:Key="HoverEase"
               EasingMode="EaseOut"/>

    <Style TargetType="{xaml:Type controls:NavigationMenuButton}">

        <Setter Property="Width"
                Value="70"/>

        <Setter Property="Height"
                Value="70"/>

        <Setter Property="RenderTransformOrigin"
                Value="0.5, 0.5"/>

        <Setter Property="Margin"
                Value="10, 5"/>

        <Setter Property="Padding"
                Value="16"/>

        <Setter Property="RenderTransform">

            <Setter.Value>

                <ScaleTransform/>

            </Setter.Value>
            
        </Setter>

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="{xaml:Type controls:NavigationMenuButton}">

                    <Border CornerRadius="15"
                            Background="#29292A"
                            BorderBrush="#323233">

                        <Grid>

                            <Path Data="{TemplateBinding Icon}"
                                  Stretch="Uniform"
                                  Fill="#444"
                                  Margin="{TemplateBinding Padding}"/>

                            <Grid xaml:Name="PART_VisualSelecting">

                                <Grid.Effect>

                                    <BlurEffect Radius="20"/>

                                </Grid.Effect>
                                
                                <Path Data="{TemplateBinding Icon}"
                                      Stretch="Uniform"
                                      Fill="{TemplateBinding Foreground}"
                                      Margin="{TemplateBinding Padding}"/>

                                <Ellipse Width="{TemplateBinding Width}"/>

                            </Grid>

                            <Path Data="{TemplateBinding Icon}"
                                  Stretch="Uniform"
                                  Fill="{TemplateBinding Foreground}"
                                  Margin="{TemplateBinding Padding}"/>

                        </Grid>
                        
                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsChecked"
                                 Value="True">

                            <Trigger.EnterActions>

                                <BeginStoryboard>

                                    <Storyboard>

                                        <DoubleAnimation Storyboard.TargetName="PART_VisualSelecting"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.3"/>

                                    </Storyboard>
                                    
                                </BeginStoryboard>
                                
                            </Trigger.EnterActions>

                            <Trigger.ExitActions>

                                <BeginStoryboard>

                                    <Storyboard>

                                        <DoubleAnimation Storyboard.TargetName="PART_VisualSelecting"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.1"/>

                                    </Storyboard>
                                    
                                </BeginStoryboard>
                                
                            </Trigger.ExitActions>
                            
                        </Trigger>

                        <Trigger Property="IsMouseOver"
                                 Value="True">

                            <Trigger.EnterActions>

                                <BeginStoryboard>

                                    <Storyboard>

                                        <ThicknessAnimation Storyboard.TargetProperty="Padding"
                                                            To="12"
                                                            Duration="0:0:0.2"
                                                            EasingFunction="{StaticResource HoverEase}"/>

                                    </Storyboard>

                                </BeginStoryboard>
                                
                            </Trigger.EnterActions>

                            <Trigger.ExitActions>

                                <BeginStoryboard>

                                    <Storyboard>

                                        <ThicknessAnimation Storyboard.TargetProperty="Padding"
                                                            To="16"
                                                            Duration="0:0:0.15"
                                                            EasingFunction="{StaticResource HoverEase}"/>

                                    </Storyboard>
                                    
                                </BeginStoryboard>
                                
                            </Trigger.ExitActions>
                            
                        </Trigger>

                        <EventTrigger RoutedEvent="Click">

                            <BeginStoryboard>

                                <Storyboard>

                                    <DoubleAnimation Storyboard.TargetProperty="(RadioButton.RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="0.9"
                                                     Duration="0:0:0.15"
                                                     EasingFunction="{StaticResource ScaleEase}"
                                                     AutoReverse="True"/>

                                    <DoubleAnimation Storyboard.TargetProperty="(RadioButton.RenderTransform).(ScaleTransform.ScaleY)"
                                                     To="0.9"
                                                     Duration="0:0:0.15"
                                                     EasingFunction="{StaticResource ScaleEase}"
                                                     AutoReverse="True"/>

                                </Storyboard>
                                
                            </BeginStoryboard>
                            
                        </EventTrigger>
                        
                    </ControlTemplate.Triggers>
                    
                </ControlTemplate>
                
            </Setter.Value>
            
        </Setter>
        
    </Style>
    
</ResourceDictionary>