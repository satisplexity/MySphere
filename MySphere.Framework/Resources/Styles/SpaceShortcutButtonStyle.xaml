<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:MySphere.Framework.Controls.Navigation"
    xmlns:helpers="clr-namespace:MySphere.Framework.VisualHelpers">

    <ResourceDictionary.MergedDictionaries>

        <ResourceDictionary
            Source="/MySphere.Framework;component/Resources/Styles/TextBlockStyles.xaml"/>

    </ResourceDictionary.MergedDictionaries>

    <CubicEase
        x:Key="HoverInEasing"
        EasingMode="EaseOut"/>

    <BackEase
        x:Key="HoverOutEasing"
        EasingMode="EaseOut"
        Amplitude="1.1"/>

    <SineEase
        x:Key="ClickEase"
        EasingMode="EaseOut"/>

    <Style
        TargetType="{x:Type controls:SpaceShortcutButton}">

        <Setter
            Property="Width"
            Value="200"/>

        <Setter
            Property="Height"
            Value="300"/>

        <Setter
            Property="Padding"
            Value="40"/>

        <Setter
            Property="Margin"
            Value="20"/>

        <Setter
            Property="RenderTransformOrigin"
            Value="0.5, 0.5"/>

        <Setter
            Property="RenderTransform">

            <Setter.Value>

                <ScaleTransform/>

            </Setter.Value>
            
        </Setter>

        <Setter
            Property="Template">

            <Setter.Value>

                <ControlTemplate
                    TargetType="{x:Type controls:SpaceShortcutButton}">

                    <Border
                        CornerRadius="20"
                        Background="#272728"
                        BorderThickness="2"
                        helpers:ClipHelper.Enable="True"
                        RenderTransformOrigin="0.5, 0.7">

                        <Border.RenderTransform>

                            <ScaleTransform
                                x:Name="PART_Scale"/>

                        </Border.RenderTransform>
                        
                        <Border.BorderBrush>

                            <LinearGradientBrush
                                StartPoint="0.3, 0"
                                EndPoint="0.7, 1">

                                <GradientStop
                                    Color="#3C3C3C"
                                    Offset="0"/>

                                <GradientStop
                                    Color="#323234"
                                    Offset="1"/>

                            </LinearGradientBrush>
                            
                        </Border.BorderBrush>
                        
                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition
                                    Height="*"/>
                                
                                <RowDefinition
                                    Height="3*"/>

                            </Grid.RowDefinitions>

                            <TextBlock
                                Text="{TemplateBinding Title}"
                                Style="{StaticResource SpaceShortcutTitle}"/>

                            <Grid
                                Grid.Row="1"
                                Opacity="0.3">

                                <Grid.Effect>

                                    <BlurEffect
                                        Radius="50"/>

                                </Grid.Effect>
                                
                                <Path
                                    Data="{TemplateBinding Icon}"
                                    Stretch="Uniform"
                                    Margin="{TemplateBinding Padding}"
                                    Fill="{TemplateBinding Foreground}"/>

                                <Ellipse
                                    Fill="{TemplateBinding Foreground}"
                                    Width="160"
                                    Height="80"
                                    Margin="0, 0, 0, -50"
                                    VerticalAlignment="Bottom"/>

                            </Grid>

                            <Path
                                Data="{TemplateBinding Icon}"
                                Stretch="Uniform"
                                Margin="{TemplateBinding Padding}"
                                Fill="{TemplateBinding Foreground}"
                                Grid.Row="1"/>

                        </Grid>
                        
                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger
                            Property="IsMouseOver"
                            Value="True">

                            <Trigger.EnterActions>

                                <BeginStoryboard>

                                    <Storyboard>

                                        <DoubleAnimation
                                            Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)"
                                            To="1.1"
                                            Duration="0:0:0.3"
                                            EasingFunction="{StaticResource HoverOutEasing}"/>

                                        <DoubleAnimation
                                            Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)"
                                            To="1.1"
                                            Duration="0:0:0.3"
                                            EasingFunction="{StaticResource HoverOutEasing}"/>

                                    </Storyboard>
                                    
                                </BeginStoryboard>
                                
                            </Trigger.EnterActions>

                            <Trigger.ExitActions>

                                <BeginStoryboard>

                                    <Storyboard>

                                        <DoubleAnimation
                                            Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)"
                                            To="1"
                                            Duration="0:0:0.4"
                                            EasingFunction="{StaticResource HoverInEasing}"/>

                                        <DoubleAnimation
                                            Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)"
                                            To="1"
                                            Duration="0:0:0.4"
                                            EasingFunction="{StaticResource HoverInEasing}"/>

                                    </Storyboard>
                                    
                                </BeginStoryboard>
                                
                            </Trigger.ExitActions>
                            
                        </Trigger>

                        <EventTrigger
                            RoutedEvent="Click">

                            <BeginStoryboard>

                                <Storyboard>

                                    <DoubleAnimation
                                        Storyboard.TargetName="PART_Scale"
                                        Storyboard.TargetProperty="ScaleX"
                                        To="0.9"
                                        From="1"
                                        Duration="0:0:0.15"
                                        EasingFunction="{StaticResource ClickEase}"
                                        AutoReverse="True"/>

                                    <DoubleAnimation
                                        Storyboard.TargetName="PART_Scale"
                                        Storyboard.TargetProperty="ScaleY"
                                        To="0.9"
                                        From="1"
                                        Duration="0:0:0.15"
                                        EasingFunction="{StaticResource ClickEase}"
                                        AutoReverse="True"/>

                                </Storyboard>
                                
                            </BeginStoryboard>
                            
                        </EventTrigger>
                        
                    </ControlTemplate.Triggers>
                    
                </ControlTemplate>
                
            </Setter.Value>
            
        </Setter>
        
    </Style>
    
</ResourceDictionary>