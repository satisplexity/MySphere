<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:MySphere.Framework.Controls.Navigation"
                    xmlns:helpers="clr-namespace:MySphere.Framework.VisualHelpers">

    <ResourceDictionary.MergedDictionaries>

        <ResourceDictionary Source="/MySphere.Framework;component/Resources/Styles/TextBlockStyles.xaml"/>

    </ResourceDictionary.MergedDictionaries>
    
    <Style TargetType="{x:Type controls:SpaceShortcutButton}">

        <Setter Property="Width"
                Value="200"/>

        <Setter Property="Height"
                Value="300"/>

        <Setter Property="Padding"
                Value="40"/>

        <Setter Property="Margin"
                Value="15"/>

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="{x:Type controls:SpaceShortcutButton}">

                    <Border CornerRadius="20"
                            Background="#272728"
                            BorderThickness="2"
                            helpers:ClipHelper.Enable="True">

                        <Border.BorderBrush>

                            <LinearGradientBrush StartPoint="0.3, 0"
                                                 EndPoint="0.7, 1">

                                <GradientStop Color="#3C3C3C"
                                              Offset="0"/>

                                <GradientStop Color="#323234"
                                              Offset="1"/>

                            </LinearGradientBrush>
                            
                        </Border.BorderBrush>
                        
                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="*"/>
                                <RowDefinition Height="3*"/>

                            </Grid.RowDefinitions>

                            <TextBlock Text="{TemplateBinding Title}"
                                       Style="{StaticResource SpaceShortcutTitle}"/>

                            <Grid Grid.Row="1"
                                  Opacity="0.3">

                                <Grid.Effect>

                                    <BlurEffect Radius="50"/>

                                </Grid.Effect>
                                
                                <Path Data="{TemplateBinding Icon}"
                                      Stretch="Uniform"
                                      Margin="{TemplateBinding Padding}"
                                      Fill="{TemplateBinding Foreground}"/>

                                <Ellipse Fill="{TemplateBinding Foreground}"
                                         Width="150"
                                         Height="100"
                                         Margin="0, 0, 0, -50"
                                         VerticalAlignment="Bottom"/>

                            </Grid>

                            <Path Data="{TemplateBinding Icon}"
                                  Stretch="Uniform"
                                  Margin="{TemplateBinding Padding}"
                                  Fill="{TemplateBinding Foreground}"
                                  Grid.Row="1"/>

                        </Grid>
                        
                    </Border>
                    
                </ControlTemplate>
                
            </Setter.Value>
            
        </Setter>
        
    </Style>
    
</ResourceDictionary>