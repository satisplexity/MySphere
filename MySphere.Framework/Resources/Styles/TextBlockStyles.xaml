<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:xaml="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style xaml:Key="TextBlockBase"
           TargetType="{xaml:Type TextBlock}">

        <Setter Property="FontFamily"
                Value="{StaticResource Comfortaa}"/>

        <Setter Property="Foreground"
                Value="#CCC"/>

    </Style>

    <Style xaml:Key="PageHeader"
           TargetType="{xaml:Type TextBlock}"
           BasedOn="{StaticResource TextBlockBase}">

        <Setter Property="FontSize"
                Value="40"/>

        <Setter Property="FontWeight"
                Value="DemiBold"/>

        <Setter Property="VerticalAlignment"
                Value="Center"/>

        <Setter Property="HorizontalAlignment"
                Value="Left"/>

        <Setter Property="Foreground">

            <Setter.Value>

                <LinearGradientBrush StartPoint="0.2, 0"
                                     EndPoint="0.8, 1">

                    <GradientStop Color="#CCCCCE"
                                  Offset="0"/>

                    <GradientStop Color="#C9C9CA"
                                  Offset="1"/>

                </LinearGradientBrush>

            </Setter.Value>

        </Setter>

    </Style>
    
</ResourceDictionary>