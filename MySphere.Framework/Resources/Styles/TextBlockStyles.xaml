<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="Comfortaa">
        /MySphere.Framework;component/Resources/Fonts/#Comfortaa
    </FontFamily>

    <Style x:Key="TextBlockBase"
           TargetType="{x:Type TextBlock}">

        <Setter Property="FontFamily"
                Value="{StaticResource Comfortaa}"/>

        <Setter Property="Foreground"
                Value="#CCC"/>

    </Style>

    <Style x:Key="PageHeader"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource TextBlockBase}">

        <Setter Property="FontSize"
                Value="40"/>

        <Setter Property="FontWeight"
                Value="Black"/>

        <Setter Property="VerticalAlignment"
                Value="Center"/>

        <Setter Property="HorizontalAlignment"
                Value="Left"/>

        <Setter Property="Foreground">

            <Setter.Value>

                <LinearGradientBrush StartPoint="0.2, 0"
                                     EndPoint="0.8, 1">

                    <GradientStop Color="#BCA7CE"
                                  Offset="0"/>

                    <GradientStop Color="#C8B7CA"
                                  Offset="1"/>

                </LinearGradientBrush>

            </Setter.Value>

        </Setter>

    </Style>

    <Style x:Key="SpaceShortcutTitle"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource TextBlockBase}">

        <Setter Property="Foreground"
                Value="#CCD"/>

        <Setter Property="FontSize"
                Value="20"/>

        <Setter Property="Margin"
                Value="0, 15, 0, 0"/>

        <Setter Property="VerticalAlignment"
                Value="Bottom"/>

        <Setter Property="HorizontalAlignment"
               Value="Center"/>

    </Style>
    
</ResourceDictionary>