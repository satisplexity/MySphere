<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:xaml="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:home="clr-namespace:MySphere.Presentation.Hub.Sections.Home"
                    xmlns:spaces="clr-namespace:MySphere.Presentation.Hub.Sections.Spaces"
                    xmlns:account="clr-namespace:MySphere.Presentation.Hub.Sections.Account"
                    xmlns:settings="clr-namespace:MySphere.Presentation.Hub.Sections.Settings">

    <DataTemplate DataType="{xaml:Type home:HomeViewModel}">

        <home:HomeView/>

    </DataTemplate>

    <DataTemplate DataType="{xaml:Type spaces:SpacesViewModel}">

        <spaces:SpacesView/>

    </DataTemplate>

    <DataTemplate DataType="{xaml:Type account:AccoutViewModel}">

        <account:AccoutView/>

    </DataTemplate>

    <DataTemplate DataType="{xaml:Type settings:SettingsViewModel}">

        <settings:SettingsView/>

    </DataTemplate>
    
</ResourceDictionary>