<UserControl
    x:Class="MySphere.Presentation.Hub.Sections.Home.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:MySphere.Framework.Controls;assembly=MySphere.Framework">

    <Grid
        Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition
                Height="Auto"/>
            
            <RowDefinition/>

        </Grid.RowDefinitions>

        <TextBlock
            Text="Home"
            Style="{StaticResource PageHeader}"/>

        <controls:WorkInProgressBanner
            Grid.Row="1"
            Info="Here you can acces to quick navigation in your Sphere"/>

    </Grid>
    
</UserControl>