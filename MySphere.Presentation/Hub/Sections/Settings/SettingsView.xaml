<UserControl 
    x:Class="MySphere.Presentation.Hub.Sections.Settings.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:MySphere.Framework.Controls;assembly=MySphere.Framework">

    <Grid
        Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition
                Height="Auto"/>
            
            <RowDefinition/>

        </Grid.RowDefinitions>

        <TextBlock
            Text="Settings"
            Style="{StaticResource PageHeader}"/>

        <controls:WorkInProgressBanner
            Grid.Row="1"/>

    </Grid>
    
</UserControl>