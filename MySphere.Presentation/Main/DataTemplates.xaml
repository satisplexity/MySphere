<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hub="clr-namespace:MySphere.Presentation.Hub"
    xmlns:semigraph="clr-namespace:MySphere.Semigraph.Presentation;assembly=MySphere.Semigraph.Presentation">

    <DataTemplate
        DataType="{x:Type hub:HubViewModel}">

        <hub:HubView/>

    </DataTemplate>

    <DataTemplate
        DataType="{x:Type semigraph:SemigraphViewModel}">

        <semigraph:SemigraphView/>

    </DataTemplate>
    
</ResourceDictionary>