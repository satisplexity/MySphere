<UserControl x:Class="MySphere.Presentation.Main.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MySphere.Presentation.Main"
             xmlns:controls="clr-namespace:MySphere.Presentation.SpaceSwitcher.Controls">

    <UserControl.Resources>

        <ResourceDictionary Source="/Main/DataTemplates.xaml"/>

    </UserControl.Resources>

    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="50"/>
            <RowDefinition/>

        </Grid.RowDefinitions>

        <Grid>

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="4*"/>

            </Grid.ColumnDefinitions>

            <controls:SpaceSwitcherButton Grid.Column="1"/>

        </Grid>
        
        <ContentControl Content="{Binding Navigation.CurrentViewModel}"
                        Grid.Row="1"/>

    </Grid>
    
</UserControl>