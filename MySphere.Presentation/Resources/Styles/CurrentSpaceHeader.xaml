<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:MySphere.Presentation.Controls">

    <Style
        TargetType="{x:Type controls:CurrentSpaceHeader}">

        <Setter
            Property="Margin"
            Value="5"/>

        <Setter
            Property="VerticalAlignment"
            Value="Center"/>

        <Setter
            Property="Template">

            <Setter.Value>

                <ControlTemplate
                    TargetType="{x:Type controls:CurrentSpaceHeader}">

                    <StackPanel
                        Orientation="Horizontal"
                        Margin="5, 0, 0, 0">

                        <Path
                            x:Name="PART_Icon"
                            Width="30"
                            Height="30"
                            Fill="{TemplateBinding SpaceColor}"
                            Data="{TemplateBinding Icon}"
                            Stretch="Uniform"/>

                        <TextBlock
                            x:Name="PART_Title"
                            Text="{TemplateBinding Text}"
                            Foreground="{TemplateBinding SpaceColor}"
                            FontFamily="{StaticResource Comfortaa}"
                            FontSize="23"
                            FontWeight="Black"
                            VerticalAlignment="Bottom"
                            Margin="10, 0, 0, 0"/>
                        
                    </StackPanel>

                    <ControlTemplate.Triggers>

                        <Trigger
                            Property="IsSpaceUpdated"
                            Value="True">

                            <Trigger.EnterActions>

                                <BeginStoryboard>

                                    <Storyboard>

                                        <DoubleAnimation
                                            Storyboard.TargetName="PART_Icon"
                                            Storyboard.TargetProperty="Opacity"
                                            From="0.5"
                                            To="1"
                                            Duration="0:0:0.6"/>

                                        <ThicknessAnimation
                                            Storyboard.TargetName="PART_Icon"
                                            Storyboard.TargetProperty="Margin"
                                            From="-50, 0, 0, 0"
                                            To="0"
                                            Duration="0:0:0.6">

                                            <ThicknessAnimation.EasingFunction>

                                                <BackEase
                                                    Amplitude="1.05"
                                                    EasingMode="EaseOut"/>

                                            </ThicknessAnimation.EasingFunction>
                                            
                                        </ThicknessAnimation>

                                        <DoubleAnimation
                                            Storyboard.TargetName="PART_Title"
                                            Storyboard.TargetProperty="Opacity"
                                            From="0.5"
                                            To="1"
                                            Duration="0:0:0.4"/>

                                        <ThicknessAnimation
                                            Storyboard.TargetName="PART_Title"
                                            Storyboard.TargetProperty="Margin"
                                            From="-40, 0, 0, 0"
                                            To="10, 0, 0, 0"
                                            Duration="0:0:0.4">

                                            <ThicknessAnimation.EasingFunction>

                                                <BackEase
                                                    Amplitude="1.05"
                                                    EasingMode="EaseOut"/>

                                            </ThicknessAnimation.EasingFunction>

                                        </ThicknessAnimation>

                                    </Storyboard>
                                    
                                </BeginStoryboard>
                                
                            </Trigger.EnterActions>

                        </Trigger>
                        
                    </ControlTemplate.Triggers>
                    
                </ControlTemplate>
                
            </Setter.Value>
            
        </Setter>
        
    </Style>
    
</ResourceDictionary>