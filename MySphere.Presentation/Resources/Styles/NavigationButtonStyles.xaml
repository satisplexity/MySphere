<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:MySphere.Presentation.Controls"
                    xmlns:effects="clr-namespace:MySphere.Presentation.Effects">

    <BackEase x:Key="Back"
              EasingMode="EaseOut"
              Amplitude="1.5"/>

    <CubicEase x:Key="ScaleEase" EasingMode="EaseIn"/>

    <Style TargetType="{x:Type controls:NavigationButton}">

        <Setter Property="Width"
                Value="70"/>
        
        <Setter Property="Height"
                Value="70"/>

        <Setter Property="Margin"
                Value="10, 5"/>

        <Setter Property="RenderTransformOrigin"
                Value="0.5, 0.5"/>

        <Setter Property="RenderTransform">
            
            <Setter.Value>

                <ScaleTransform ScaleX="1"
                                ScaleY="1"/>

            </Setter.Value>
            
        </Setter>

        <Setter Property="Padding"
                Value="16"/>

        <Setter Property="Template">

            <Setter.Value>
                
                <ControlTemplate TargetType="{x:Type controls:NavigationButton}">

                    <ControlTemplate.Resources>

                        <SolidColorBrush x:Key="HighlightBrush"
                                         Color="{Binding HighlightingColor, RelativeSource={RelativeSource TemplatedParent}}" />

                    </ControlTemplate.Resources>

                    <Grid>
                        
                        <Grid.Clip>

                            <RectangleGeometry RadiusX="15"
                                               RadiusY="15"
                                               Rect="0, 0, 70, 70"/>
                            
                        </Grid.Clip>
                        
                        <Border CornerRadius="15"
                                Background="#212122"
                                BorderThickness="1">
                            
                            <Border.BorderBrush>
                                
                                <LinearGradientBrush StartPoint="0.2, 0"
                                                     EndPoint="0.8, 1">
                                    
                                    <LinearGradientBrush.GradientStops>
                                        
                                        <GradientStop Offset="0"
                                                      Color="#303032"/>
                                        
                                        <GradientStop Offset="1"
                                                      Color="#222224"/>
                                        
                                    </LinearGradientBrush.GradientStops>
                                
                                </LinearGradientBrush>
                            
                            </Border.BorderBrush>

                            <Border.Effect>

                                <effects:NoiseEffect Scale="100"
                                                     Intensity="0.005"/>

                            </Border.Effect>
                            
                        </Border>
                        
                        <Path Data="{TemplateBinding IconData}"
                              Fill="#313133"
                              Stretch="Uniform"
                              Margin="{TemplateBinding Padding}"/>

                        <Grid x:Name="Glow"
                              Opacity="0">

                            <Grid>
                                
                                <Grid.Effect>
                                    
                                    <BlurEffect Radius="20"/>
                                    
                                </Grid.Effect>
                                
                                <Path Data="{TemplateBinding IconData}"
                                      Fill="{TemplateBinding Foreground}"
                                      Margin="{TemplateBinding Padding}"
                                      Stretch="Uniform"/>
                                
                                <Ellipse Fill="{TemplateBinding Foreground}"
                                         Width="40"
                                         Height="15"
                                         VerticalAlignment="Bottom"
                                         Margin="0, 0, 0, -10"/>
                                
                            </Grid>
                            
                            <Path Data="{TemplateBinding IconData}"
                                  Fill="{TemplateBinding Foreground}"
                                  Margin="{TemplateBinding Padding}"
                                  Stretch="Uniform"/>
                            
                        </Grid>
                        
                    </Grid>
                    
                    <ControlTemplate.Triggers>

                        <Trigger Property="IsChecked"
                                 Value="True">

                            <Trigger.EnterActions>

                                <BeginStoryboard>

                                    <Storyboard>

                                        <DoubleAnimation Storyboard.TargetName="Glow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.5"
                                                         Duration="0:0:0.2"/>

                                    </Storyboard>
                                    
                                </BeginStoryboard>
                                
                            </Trigger.EnterActions>

                            <Trigger.ExitActions>

                                <BeginStoryboard>

                                    <Storyboard>

                                        <DoubleAnimation Storyboard.TargetName="Glow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.1"/>

                                    </Storyboard>
                                   
                                </BeginStoryboard>
                                
                            </Trigger.ExitActions>
                            
                        </Trigger>

                        <Trigger Property="IsMouseOver"
                                 Value="True">

                            <Trigger.EnterActions>

                                <BeginStoryboard>

                                    <Storyboard>

                                        <ThicknessAnimation Storyboard.TargetProperty="Padding"
                                                            To="14"
                                                            Duration="0:0:0.3"
                                                            EasingFunction="{StaticResource Back}"/>

                                    </Storyboard>
                                    
                                </BeginStoryboard>
                                
                            </Trigger.EnterActions>

                            <Trigger.ExitActions>

                                <BeginStoryboard>

                                    <Storyboard>

                                        <ThicknessAnimation Storyboard.TargetProperty="Padding"
                                                            To="16"
                                                            Duration="0:0:0.1"/>

                                    </Storyboard>
                                    
                                </BeginStoryboard>
                                
                            </Trigger.ExitActions>
                            
                        </Trigger>

                        <EventTrigger RoutedEvent="Click">

                            <BeginStoryboard>

                                <Storyboard>

                                    <DoubleAnimation Storyboard.TargetProperty="(RadioButton.RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="0.85"
                                                     Duration="0:0:0.15"
                                                     AutoReverse="True"
                                                     EasingFunction="{StaticResource ScaleEase}"/>

                                    <DoubleAnimation Storyboard.TargetProperty="(RadioButton.RenderTransform).(ScaleTransform.ScaleY)"
                                                     To="0.85"
                                                     Duration="0:0:0.15"
                                                     AutoReverse="True"
                                                     EasingFunction="{StaticResource ScaleEase}"/>

                                </Storyboard>
                                
                            </BeginStoryboard>
                            
                        </EventTrigger>
                        
                    </ControlTemplate.Triggers>
                    
                </ControlTemplate>
                
            </Setter.Value>
            
        </Setter>
        
    </Style>

</ResourceDictionary>