<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:MySphere.Presentation.Controls">

    <Style TargetType="{x:Type controls:RoundButton}">

        <Setter Property="Background"
                Value="{StaticResource WindowBackgroundSolidColorBrush}"/>

        <Setter Property="Foreground"
                Value="#AAA"/>

        <Setter Property="Margin"
                Value="1"/>

        <Setter Property="Height"
                Value="40"/>

        <Setter Property="Width"
                Value="40"/>

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="{x:Type controls:RoundButton}">

                    <Grid>

                        <Ellipse Fill="{TemplateBinding Background}"/>

                        <Path Fill="{TemplateBinding Foreground}"
                              Data="{TemplateBinding Icon}"
                              Stretch="Uniform"
                              Margin="10"/>

                    </Grid>
                    
                </ControlTemplate>
                
            </Setter.Value>
            
        </Setter>

        <Style.Triggers>

            <Trigger Property="IsMouseOver"
                     Value="True">

                <Trigger.EnterActions>

                    <BeginStoryboard>

                        <Storyboard>

                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            To="#444"
                                            Duration="0:0:0.2"/>

                        </Storyboard>
                        
                    </BeginStoryboard>
                    
                </Trigger.EnterActions>

                <Trigger.ExitActions>

                    <BeginStoryboard>

                        <Storyboard>

                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource WindowBackgroundColor}"
                                            Duration="0:0:0.1"/>

                        </Storyboard>
                        
                    </BeginStoryboard>
                    
                </Trigger.ExitActions>
                
            </Trigger>
            
        </Style.Triggers>
        
    </Style>
    
</ResourceDictionary>