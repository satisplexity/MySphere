<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:MySphere.Presentation.Controls">

    <Style TargetType="{x:Type controls:SpaceCard}">

        <Setter Property="Margin"
                Value="10"/>

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="{x:Type controls:SpaceCard}">

                    <Border CornerRadius="30"
                            Background="#222222"
                            BorderBrush="#242425"
                            BorderThickness="2">

                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="*"/>
                                <RowDefinition Height="4*"/>

                            </Grid.RowDefinitions>

                            <TextBlock Text="{TemplateBinding Title}"
                                       FontSize="20"
                                       FontFamily="{StaticResource Manrope}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom"
                                       Foreground="{TemplateBinding Foreground}"/>

                            <Path Data="{TemplateBinding Icon}"
                                  Stretch="Uniform"
                                  Fill="{TemplateBinding Foreground}"
                                  Grid.Row="1"
                                  Margin="20"/>

                        </Grid>
                        
                    </Border>
                    
                </ControlTemplate>
                
            </Setter.Value>
            
        </Setter>
        
    </Style>
    
</ResourceDictionary>