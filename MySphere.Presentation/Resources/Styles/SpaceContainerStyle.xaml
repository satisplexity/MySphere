<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <CubicEase x:Key="ShowEase"
               EasingMode="EaseInOut"/>

    <Style x:Key="SpaceContainer"
           TargetType="{x:Type UserControl}">

        <Setter Property="RenderTransformOrigin"
                Value="0.5, 0.8"/>

        <Setter Property="RenderTransform">
            <Setter.Value>

                <ScaleTransform ScaleX="0.7"
                                ScaleY="0.7"/>

            </Setter.Value>
        </Setter>

        <Setter Property="Opacity"
                Value="0"/>

        
        <Style.Triggers>

            <EventTrigger RoutedEvent="Loaded">

                <BeginStoryboard>

                    <Storyboard>

                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         To="1"
                                         Duration="0:0:0.3"/>

                        <DoubleAnimation Storyboard.TargetProperty="(UserControl.RenderTransform).(ScaleTransform.ScaleX)"
                                         To="1"
                                         Duration="0:0:0.3"
                                         EasingFunction="{StaticResource ShowEase}"/>

                        <DoubleAnimation Storyboard.TargetProperty="(UserControl.RenderTransform).(ScaleTransform.ScaleY)"
                 To="1"
                 Duration="0:0:0.3"
                 EasingFunction="{StaticResource ShowEase}"/>

                    </Storyboard>
                    
                </BeginStoryboard>
                
            </EventTrigger>
            
        </Style.Triggers>
        
    </Style>
    
</ResourceDictionary>