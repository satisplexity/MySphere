<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:MySphere.Presentation.Main.Controls"
    xmlns:helpers="clr-namespace:MySphere.Framework.VisualHelpers;assembly=MySphere.Framework">

    <KeyTime
        x:Key="StepOne">

        0:0:1

    </KeyTime>

    <KeyTime
        x:Key="StepTwo">
        
        0:0:1.1
        
    </KeyTime>

    <KeyTime
        x:Key="Step3">
        
        0:0:1.7
        
    </KeyTime>
    
    <ExponentialEase
        x:Key="KEasing"
        EasingMode="EaseOut"/>

    <CubicEase
        x:Key="MEasing"
        EasingMode="EaseInOut"/>

    <Style
        TargetType="{x:Type controls:SpaceHost}">

        <Setter
            Property="Template">

            <Setter.Value>

                <ControlTemplate
                    TargetType="{x:Type controls:SpaceHost}">

                    <Border
                        CornerRadius="20"
                        helpers:ClipHelper.Enable="True"
                        Margin="{TemplateBinding Margin}"
                        BorderThickness="2">

                        <Border.BorderBrush>

                            <LinearGradientBrush
                                StartPoint="0.5, 0"
                                EndPoint="0.5, 1">

                                <GradientStop Color="#333"
                                              Offset="0"/>

                                <GradientStop Color="#222"
                                              Offset="1"/>

                            </LinearGradientBrush>

                        </Border.BorderBrush>
                        
                        <Grid>

                            <Image
                                x:Name="PART_Image"
                                Source="{TemplateBinding PreviousSpaceImage}"
                                RenderTransformOrigin="0.5, 0.5"
                                Stretch="Fill"
                                VerticalAlignment="Stretch"
                                HorizontalAlignment="Stretch">

                                <Image.RenderTransform>

                                    <ScaleTransform
                                        x:Name="PART_Scale"
                                        ScaleX="1"
                                        ScaleY="1"/>

                                </Image.RenderTransform>
                                
                            </Image>

                            <Grid>

                                <Grid.RenderTransform>

                                    <TranslateTransform
                                        x:Name="PART_Translate"
                                        Y="0"/>

                                </Grid.RenderTransform>

                                <ContentPresenter
                                    helpers:ClipHelper.Enable="True"
                                    helpers:ClipHelper.Radius="20"
                                    Content="{TemplateBinding Content}"
                                    RenderTransformOrigin="0.5, 0.5">

                                    <ContentPresenter.RenderTransform>

                                        <ScaleTransform
                                            x:Name="PART_ContentScale"/>

                                    </ContentPresenter.RenderTransform>

                                </ContentPresenter>

                            </Grid>

                        </Grid>
                        
                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger
                            Property="IsNewSpaceOpened"
                            Value="True">

                            <Trigger.EnterActions>

                                <BeginStoryboard>

                                    <Storyboard>

                                        <DoubleAnimationUsingKeyFrames
                                            Storyboard.TargetName="PART_Scale"
                                            Storyboard.TargetProperty="ScaleX">

                                            <EasingDoubleKeyFrame
                                                KeyTime="0:0:0"
                                                Value="1"/>

                                            <EasingDoubleKeyFrame
                                                KeyTime="{StaticResource StepOne}"
                                                Value="0.8"
                                                EasingFunction="{StaticResource KEasing}"/>

                                            <EasingDoubleKeyFrame
                                                KeyTime="{StaticResource StepTwo}"
                                                Value="0.8"/>

                                            <EasingDoubleKeyFrame
                                                KeyTime="{StaticResource Step3}"
                                                Value="0.6"
                                                EasingFunction="{StaticResource MEasing}"/>

                                        </DoubleAnimationUsingKeyFrames>

                                        <DoubleAnimationUsingKeyFrames
                                            Storyboard.TargetName="PART_Scale"
                                            Storyboard.TargetProperty="ScaleY">

                                            <EasingDoubleKeyFrame
                                                KeyTime="0:0:0"
                                                Value="1"/>

                                            <EasingDoubleKeyFrame
                                                KeyTime="{StaticResource StepOne}"
                                                Value="0.8"
                                                EasingFunction="{StaticResource KEasing}"/>

                                            <EasingDoubleKeyFrame
                                                KeyTime="{StaticResource StepTwo}"
                                                Value="0.8"/>

                                            <EasingDoubleKeyFrame
                                                KeyTime="{StaticResource Step3}"
                                                Value="0.6"
                                                EasingFunction="{StaticResource MEasing}"/>

                                        </DoubleAnimationUsingKeyFrames>

                                        <DoubleAnimation
                                            Storyboard.TargetName="PART_Image"
                                            Storyboard.TargetProperty="Opacity"
                                            From="1"
                                            To="0.2"
                                            BeginTime="0:0:1.1"
                                            Duration="0:0:0.5"/>

                                        <DoubleAnimationUsingKeyFrames
                                            Storyboard.TargetName="PART_Translate"
                                            Storyboard.TargetProperty="Y">

                                            <EasingDoubleKeyFrame
                                                KeyTime="0:0:0"
                                                Value="1500"/>

                                            <EasingDoubleKeyFrame
                                                KeyTime="{StaticResource StepTwo}"
                                                Value="1500"/>

                                            <EasingDoubleKeyFrame
                                                KeyTime="{StaticResource Step3}"
                                                Value="0"
                                                EasingFunction="{StaticResource KEasing}"/>

                                        </DoubleAnimationUsingKeyFrames>

                                        <DoubleAnimationUsingKeyFrames
                                            Storyboard.TargetName="PART_ContentScale"
                                            Storyboard.TargetProperty="ScaleX">

                                            <EasingDoubleKeyFrame
                                                KeyTime="0:0:0"
                                                Value="0.7"/>

                                            <EasingDoubleKeyFrame
                                                KeyTime="{StaticResource StepTwo}"
                                                Value="0.7"/>

                                            <EasingDoubleKeyFrame
                                                KeyTime="{StaticResource Step3}"
                                                Value="1"
                                                EasingFunction="{StaticResource KEasing}"/>

                                        </DoubleAnimationUsingKeyFrames>

                                        <DoubleAnimationUsingKeyFrames
                                            Storyboard.TargetName="PART_ContentScale"
                                            Storyboard.TargetProperty="ScaleY">

                                            <EasingDoubleKeyFrame
                                                KeyTime="0:0:0"
                                                Value="0.7"/>

                                            <EasingDoubleKeyFrame
                                                KeyTime="{StaticResource StepTwo}"
                                                Value="0.7"/>

                                            <EasingDoubleKeyFrame
                                                KeyTime="{StaticResource Step3}"
                                                Value="1"
                                                EasingFunction="{StaticResource KEasing}"/>

                                        </DoubleAnimationUsingKeyFrames>

                                    </Storyboard>

                                </BeginStoryboard>

                            </Trigger.EnterActions>

                        </Trigger>
                        
                    </ControlTemplate.Triggers>
                    
                </ControlTemplate>
                
            </Setter.Value>
            
        </Setter>
        
    </Style>
    
</ResourceDictionary>