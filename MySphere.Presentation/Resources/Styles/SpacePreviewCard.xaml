<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:MySphere.Presentation.Controls"
    xmlns:effects="clr-namespace:MySphere.Framework.Effects;assembly=MySphere.Framework">

    <Style
        TargetType="{x:Type controls:SpacePreviewCard}">

        <Setter
            Property="Template">

            <Setter.Value>

                <ControlTemplate
                    TargetType="{x:Type controls:SpacePreviewCard}">

                    <Grid>

                        <Image
                                Source="{TemplateBinding PreviewImage}"/>

                        <TextBlock
                                VerticalAlignment="Top"
                                HorizontalAlignment="Left"
                                Margin="0, -40, 0, 0"
                                Foreground="#CCE"
                                Text="{TemplateBinding Title}"
                                FontSize="30"
                                FontFamily="{StaticResource Comfortaa}"/>
                    </Grid>

                </ControlTemplate>
                
            </Setter.Value>
            
        </Setter>
        
    </Style>
    
</ResourceDictionary>