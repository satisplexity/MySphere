<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:MySphere.Presentation.Controls"
    xmlns:effects="clr-namespace:MySphere.Framework.Effects;assembly=MySphere.Framework">

    <Style
        TargetType="{x:Type controls:SpacePreviewCard}">

        <Setter
            Property="Template">

            <Setter.Value>

                <ControlTemplate
                    TargetType="{x:Type controls:SpacePreviewCard}">

                    <Border>

                        <Border.OpacityMask>

                            <LinearGradientBrush
                                StartPoint="0, 0.5"
                                EndPoint="1, 0.5">

                                <GradientStop
                                    Color="#FFFFFFFF"
                                    Offset="0"/>

                                <GradientStop
                                    Color="#FFFFFFFF"
                                    Offset="0.7"/>
                                
                                <GradientStop
                                    Color="#00FFFFFF"
                                    Offset="1"/>

                            </LinearGradientBrush>
                            
                        </Border.OpacityMask>
                        
                        <Border.Effect>

                            <effects:PerspectiveEffect
                                TopRight="{TemplateBinding PerspectiveTopRight}"
                                BottomRight="{TemplateBinding PerspectiveBottomRight}"/>
                            
                        </Border.Effect>
                        
                        <Grid>
                            
                            <Image
                                Source="{TemplateBinding PreviewImage}"/>

                            <TextBlock VerticalAlignment="Top"
                                   HorizontalAlignment="Left"
                                   Margin="0, -100, 0, 0"
                                   Foreground="#555"
                                   Text="SPACE NAME"
                                   FontSize="40"
                                   FontFamily="{StaticResource Comfortaa}"/>
                        </Grid>

                    </Border>
                    
                </ControlTemplate>
                
            </Setter.Value>
            
        </Setter>
        
    </Style>
    
</ResourceDictionary>