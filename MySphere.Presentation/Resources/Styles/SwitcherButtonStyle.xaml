<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    
    
    <Style x:Key="SwitcherButton"
           TargetType="{x:Type Button}">

        <Setter Property="RenderTransformOrigin"
                Value="0.5, 0"/>

        <Setter Property="RenderTransform">
            <Setter.Value>

                <ScaleTransform/>

            </Setter.Value>
        </Setter>
        
        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="{x:Type Button}">

                    <Grid>

                        <Path Data="{StaticResource Heading}"
                              Stretch="Uniform"
                              Fill="#1C1C1F">
                            
                        </Path>
                        <Path Data="{StaticResource Heading}"
                              Margin="5, 0, 5, 2"
                              Stretch="Uniform"
                              Fill="#232324">
                        </Path>

                    </Grid>
                    
                </ControlTemplate>
                
            </Setter.Value>
            
        </Setter>

        <Style.Triggers>

            <Trigger Property="IsMouseOver"
                    Value="True">

                <Trigger.EnterActions>

                    <BeginStoryboard>

                        <Storyboard>

                            <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1.2"
                                             Duration="0:0:0.2"
                                             EasingFunction="{StaticResource ShowEase}"/>

                            <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)"
                 To="1.2"
                 Duration="0:0:0.2"
                 EasingFunction="{StaticResource ShowEase}"/>

                        </Storyboard>
                        
                    </BeginStoryboard>
                    
                </Trigger.EnterActions>

                
                
                <Trigger.ExitActions>

                    <BeginStoryboard>

                        <Storyboard>

                            <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)"
                            To="1"
                            Duration="0:0:0.15"
                            EasingFunction="{StaticResource ShowEase}"/>

                            <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)"
To="1"
Duration="0:0:0.15"
EasingFunction="{StaticResource ShowEase}"/>

                        </Storyboard>
                        
                    </BeginStoryboard>
                    
                </Trigger.ExitActions>
                
            </Trigger>
            
        </Style.Triggers>
        
    </Style>
    
</ResourceDictionary>