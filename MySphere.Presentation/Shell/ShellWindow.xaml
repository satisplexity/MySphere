        Width="800"
        Background="#191919">

    <Window.Resources>

        <ResourceDictionary Source="/Shell/DataTemplates.xaml"/>

    </Window.Resources>

    <Grid>

        <ContentControl Content="{Binding Navigation.CurrentViewModel}"/>

