<UserControl
    x:Class="MySphere.Presentation.SpaceSwitcher.SpaceSwitcherView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MySphere.Presentation.SpaceSwitcher"
    xmlns:effects="clr-namespace:MySphere.Framework.Effects;assembly=MySphere.Framework"
    xmlns:controls="clr-namespace:MySphere.Presentation.Controls"
    xmlns:behaviors="clr-namespace:MySphere.Presentation.Behaviors">

    <Grid Background="#191919"
          behaviors:MouseWheel.NextCommand="{Binding NextCommand}"
          behaviors:MouseWheel.PreviousCommand="{Binding PreviousCommand}">

        <ItemsControl
            ItemsSource="{Binding Previews}">
            
            <ItemsControl.ItemsPanel>
                
                <ItemsPanelTemplate>
                    
                    <Grid/>
                    
                </ItemsPanelTemplate>
                
            </ItemsControl.ItemsPanel>
            
            <ItemsControl.ItemTemplate>

                <DataTemplate>

                    <controls:SpacePreviewCard
                        PreviewImage="{Binding Preview}"
                        Width="{Binding Width}"
                        Height="{Binding Height}"
                        PositionIndex="{Binding Index}"
                        Title="{Binding Title}"/>

                </DataTemplate>

            </ItemsControl.ItemTemplate>
            
        </ItemsControl>

        <Image
            Source="{Binding CurrentPreview}"
            Visibility="{Binding PreviewVisibility}">

            <Image.Style>

                <Style
                    TargetType="{x:Type Image}">

                    <Setter
                        Property="RenderTransformOrigin"
                        Value="0.5, 0.5"/>

                    <Setter
                        Property="RenderTransform">

                        <Setter.Value>

                            <ScaleTransform/>

                        </Setter.Value>
                        
                    </Setter>

                    <Style.Triggers>

                        <DataTrigger
                            Binding="{Binding PlayOpenAnimation}"
                            Value="true">

                            <DataTrigger.EnterActions>

                                <BeginStoryboard>

                                    <Storyboard>

                                        <DoubleAnimation
                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                            From="1"
                                            To="0.33"
                                            Duration="0:0:0.5"
                                            EasingFunction="{StaticResource MEasing}"/>

                                        <DoubleAnimation
                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                            From="1"
                                            To="0.33"
                                            Duration="0:0:0.5"
                                            EasingFunction="{StaticResource MEasing}"/>

                                    </Storyboard>
                                    
                                </BeginStoryboard>
                                
                            </DataTrigger.EnterActions>

                            <DataTrigger.ExitActions>

                                <BeginStoryboard>

                                    <Storyboard>
                                        
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                            From="0.33"
                                            To="1"
                                            Duration="0:0:0.5"
                                            EasingFunction="{StaticResource MEasing}"/>

                                        <DoubleAnimation
                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                            From="0.33"
                                            To="1"
                                            Duration="0:0:0.5"
                                            EasingFunction="{StaticResource MEasing}"/>

                                    </Storyboard>
                                    
                                </BeginStoryboard>
                                
                            </DataTrigger.ExitActions>
                            
                        </DataTrigger>
                        
                    </Style.Triggers>
                    
                </Style>
                
            </Image.Style>
            
        </Image>

    </Grid>

</UserControl>