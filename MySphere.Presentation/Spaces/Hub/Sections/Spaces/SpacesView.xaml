<UserControl x:Class="MySphere.Presentation.Spaces.Hub.Sections.Spaces.SpacesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MySphere.Presentation.Spaces.Hub.Sections.Spaces"
             xmlns:controls="clr-namespace:MySphere.Presentation.Controls"
             xmlns:effects="clr-namespace:MySphere.Presentation.Effects">

    <Grid Margin="10">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>
            <RowDefinition/>

        </Grid.RowDefinitions>

        <TextBlock Text="Spaces"
                   Style="{StaticResource PageHeader}"/>

        <UniformGrid Columns="6"
                     Grid.Row="1"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">

            <controls:SpaceCard Title="Semigraph"
                Icon="{StaticResource SemigraphIcon}"
                                Command="{Binding OpenSemigraphCommand}">

                <controls:SpaceCard.Foreground>

                    <LinearGradientBrush StartPoint="0.4, 0"
                             EndPoint="0.7, 1">

                        <GradientStop Color="#C7D"
                          Offset="0"/>

                        <GradientStop Color="#A4A"
                          Offset="1"/>

                    </LinearGradientBrush>

                </controls:SpaceCard.Foreground>

            </controls:SpaceCard>

            <controls:SpaceCard Title="PathLab"
                Icon="{StaticResource PathLabIcon}">

                <controls:SpaceCard.Foreground>

                    <LinearGradientBrush StartPoint="0.4, 0"
                             EndPoint="0.7, 1">

                        <GradientStop Color="#C88"
                          Offset="0"/>

                        <GradientStop Color="#A67"
                          Offset="1"/>

                    </LinearGradientBrush>

                </controls:SpaceCard.Foreground>

            </controls:SpaceCard>

            <controls:SpaceCard Title="SortLab"
                Icon="{StaticResource SortLabIcon}">

                <controls:SpaceCard.Foreground>

                    <LinearGradientBrush StartPoint="0.4, 0"
                             EndPoint="0.7, 1">

                        <GradientStop Color="#78C"
                          Offset="0"/>

                        <GradientStop Color="#87A"
                          Offset="1"/>

                    </LinearGradientBrush>

                </controls:SpaceCard.Foreground>

            </controls:SpaceCard>

            <controls:SpaceCard Title="Mergery"
                Icon="{StaticResource MergeryIcon}">

                <controls:SpaceCard.Foreground>

                    <LinearGradientBrush StartPoint="0.4, 0"
                             EndPoint="0.7, 1">

                        <GradientStop Color="#694"
                          Offset="0"/>

                        <GradientStop Color="#5A7"
                          Offset="1"/>

                    </LinearGradientBrush>

                </controls:SpaceCard.Foreground>

            </controls:SpaceCard>

            <controls:SpaceCard Title="Weatherly"
                Icon="{StaticResource WeatherlyIcon}">
                <controls:SpaceCard.Foreground>

                    <LinearGradientBrush StartPoint="0.3, 0"
                             EndPoint="0.7, 1">

                        <GradientStop Color="#59C"
                          Offset="0.1"/>

                        <GradientStop Color="#42C"
                          Offset="1"/>

                    </LinearGradientBrush>

                </controls:SpaceCard.Foreground>
            </controls:SpaceCard>

            <controls:SpaceCard Title="FractalLab"
                Icon="{StaticResource FractalLabIcon}"
                                Command="{Binding OpenFractalLabCommand}">

                <controls:SpaceCard.Foreground>

                    <LinearGradientBrush StartPoint="0.2, 0"
                             EndPoint="0.5, 1">

                        <GradientStop Color="#B83"
                          Offset="0"/>

                        <GradientStop Color="#E73"
                          Offset="1"/>

                    </LinearGradientBrush>

                </controls:SpaceCard.Foreground>

            </controls:SpaceCard>

            <controls:SpaceCard Title="CodeScope"
                Icon="{StaticResource CodeScopeIcon}">

                <controls:SpaceCard.Foreground>

                    <LinearGradientBrush StartPoint="0.2, 0"
                             EndPoint="0.5, 1">

                        <GradientStop Color="#59C"
                          Offset="0"/>

                        <GradientStop Color="#5A30AB"
                          Offset="1"/>

                    </LinearGradientBrush>

                </controls:SpaceCard.Foreground>

            </controls:SpaceCard>

            <controls:SpaceCard Title="Mazio"
    Icon="{StaticResource MazioIcon}">

                <controls:SpaceCard.Foreground>

                    <LinearGradientBrush StartPoint="0.2, 0"
   EndPoint="0.5, 1">

                        <GradientStop Color="#Df6e4f"
Offset="0"/>

                        <GradientStop Color="#DeA46b"
Offset="1"/>

                    </LinearGradientBrush>

                   

                </controls:SpaceCard.Foreground>

            </controls:SpaceCard>

            <controls:SpaceCard Title="BoidLab"
Icon="{StaticResource BoidLabIcon}">

                <controls:SpaceCard.Foreground>

                    <LinearGradientBrush StartPoint="0.2, 0"
   EndPoint="0.5, 1">

                        <GradientStop Color="#45A7D7"
Offset="0"/>

                        <GradientStop Color="#1052A4"
Offset="1"/>

                    </LinearGradientBrush>
                </controls:SpaceCard.Foreground>

            </controls:SpaceCard>

            <controls:SpaceCard Title="Chess#"
Icon="{StaticResource ChessSharpIcon}">

                <controls:SpaceCard.Foreground>

                    <LinearGradientBrush StartPoint="0.2, 0"
             EndPoint="0.5, 1">

                        <GradientStop Color="#9750EF"
          Offset="0"/>

                        <GradientStop Color="#CF6BF3"
          Offset="1"/>

                    </LinearGradientBrush>

                </controls:SpaceCard.Foreground>

            </controls:SpaceCard>

            <controls:SpaceCard Title="KittyCatch"
Icon="{StaticResource KittyCatchIcon}">

                <controls:SpaceCard.Foreground>

                    <LinearGradientBrush StartPoint="0.2, 0"
             EndPoint="0.5, 1">

                        <GradientStop Color="#B494B3"
          Offset="0"/>

                        <GradientStop Color="#Bc57Ba"
          Offset="1"/>

                    </LinearGradientBrush>

                </controls:SpaceCard.Foreground>

            </controls:SpaceCard>

            <controls:SpaceCard Title="4 in row"
Icon="{StaticResource FourInRowIcon}">

                <controls:SpaceCard.Foreground>

                    <LinearGradientBrush StartPoint="0.2, 0"
   EndPoint="0.5, 1">

                        <GradientStop Color="#11B87E"
Offset="0"/>

                        <GradientStop Color="#2f4453"
Offset="1"/>

                    </LinearGradientBrush>

                </controls:SpaceCard.Foreground>

            </controls:SpaceCard>

        </UniformGrid>
        

    </Grid>

</UserControl>