<Window x:Class="MySphere.Presentation.Spaces.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MySphere.Presentation.Spaces.Shell"
        Title="MySphere"
        xmlns:effects="clr-namespace:MySphere.Presentation.Effects"
        xmlns:controls="clr-namespace:MySphere.Presentation.Controls"
        Style="{StaticResource FullScreenWindowStyle}"
        WindowState="Maximized"
        KeyDown="Grid_KeyDown">

    <Window.Resources>

        <ResourceDictionary Source="/Spaces/Shell/ShellViewModelsTemplates.xaml"/>

    </Window.Resources>
    
    <Grid>

        <Rectangle Fill="{StaticResource WindowBackgroundSolidColorBrush}">

            <Rectangle.Effect>
                <effects:NoiseEffect Scale="100"
                                     Intensity="0.005"/>

            </Rectangle.Effect>

        </Rectangle>

        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="auto"/>
                <RowDefinition/>

            </Grid.RowDefinitions>

            <Button 
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Panel.ZIndex="10"
                Height="60"
                    Style="{StaticResource SwitcherButton}"
                    Click="ToogleSwitcher"/>

            <Border Grid.Row="1"
                    CornerRadius="15"
                    Margin="15"
                    x:Name="PART_Container"
                    Background="#151515"
                    RenderTransformOrigin="0.5, 0.8">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="PART_ContainerScale"/>
                </Border.RenderTransform>

                <Grid x:Name="SpaceContent">
                    <Grid.Clip>
                         <RectangleGeometry RadiusX="15"
                                       RadiusY="15"
                                       Rect="0, 0, 1900, 1000">
                        
                    </RectangleGeometry>
                    </Grid.Clip>

                    <Rectangle Fill="#151516">

                        <Rectangle.Effect>

                            <effects:NoiseEffect Scale="100"
                                                 Intensity="0.005"/>

                        </Rectangle.Effect>

                    </Rectangle>

                    <ContentControl x:Name="PART_Content" Content="{Binding Navigation.CurrentViewModel}"/>

                    <local:SpaceSwitcher x:Name="PART_SpaceSwitcher"/>
                    
                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>