<UserControl x:Class="MySphere.Presentation.Spaces.Shell.SpaceSwitcher"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MySphere.Presentation.Spaces.Shell"
             xmlns:effects="clr-namespace:MySphere.Presentation.Effects">

    <Grid MouseWheel="SlideSpaces">

        <Rectangle Fill="{StaticResource WindowBackgroundSolidColorBrush}">

            <Rectangle.Effect>

                <effects:NoiseEffect Scale="100"
                                     Intensity="0.005"/>

            </Rectangle.Effect>
            
        </Rectangle>

        <Grid x:Name="PART_SpacesContainer">

            <Grid.RenderTransform>

                <TranslateTransform x:Name="PART_TranslateTransform"/>

            </Grid.RenderTransform>
            
        </Grid>

        <Image x:Name="PART_PreviewImage"
               RenderTransformOrigin="0.5, 0.5">

            <Image.RenderTransform>

                <ScaleTransform x:Name="PART_ScaleTrasform"/>

            </Image.RenderTransform>
            
        </Image>

    </Grid>
    
</UserControl>