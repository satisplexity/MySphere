<Window x:Class="MySphere.Presentation.Views.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MySphere.Presentation.Views.Windows"
        Title="MainWindow"
        Height="450" 
        Width="800"
        xmlns:controls="clr-namespace:MySphere.Presentation.Controls"
        xmlns:effect="clr-namespace:MySphere.Presentation.Effects"
        WindowState="Maximized"
        WindowStyle="None">

    <Grid Background="#191919">

        <Grid Background="#191919">
            <Grid.Effect>

                <effect:NoiseEffect Scale="10"
                                    Intensity="0.005"/>

            </Grid.Effect>


        </Grid>

        <Grid VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Path Data="{StaticResource Heading}"
                  Fill="#252525"
                  Grid.Column="1"
                  Stretch="Uniform"
                  Width="400"
                  Margin="0, -40"/>

        </Grid>
        
        <Grid>

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>

            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">

                <controls:NavigationButton IconData="{StaticResource HomeIcon}"
                                       Foreground="#7642C3"
                                       IsChecked="True"/>
                <controls:NavigationButton IconData="{StaticResource StorageIcon}"
                                       Foreground="#C34276"/>
                <controls:NavigationButton IconData="{StaticResource TokenIcon}"
                                       Foreground="#F48F44"/>
                <controls:NavigationButton IconData="{StaticResource SettingIcon}"
                                       Foreground="#44A4CF"/>

            </StackPanel>

        </Grid>

    </Grid>

</Window>